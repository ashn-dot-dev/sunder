import "std";

func main() void {
    var general_allocator = std::general_allocator::init();
    defer general_allocator.fini();

    var alignments = (:[]usize)[8, 16, 32, 64, 128, 256, 512];
    for i in countof(alignments) {
        var align = alignments[i];
        std::print_format_line(
            std::out(),
            "checking align={}",
            (:[]std::formatter)[std::formatter::init[[usize]](&align)]);

        let attempts = 1000u; # arbitrary number of attempts to catch a failure
        for _ in attempts {
            var result = general_allocator.allocate(align, 1);
            var addr = (:usize)result.value();
            assert addr % align == 0;
        }

        std::print_line(std::out(), "...success");
    }
}
