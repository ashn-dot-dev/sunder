import "std";

var a_f32 = (:f32)+123;
var b_f32 = (:f32)-123;
var c_f32 = (:f32)+123s;
var d_f32 = (:f32)-123s;
var e_f32 = (:f32)9223372036854775809u64;  # s64::MAX + 2
var f_f32 = (:f32)18446744073709551615u64; # u64::MAX
var g_f32 = (:f32)-9223372036854775808s64; # s64::MIN

var a_f64 = (:f64)+123;
var b_f64 = (:f64)-123;
var c_f64 = (:f64)+123s;
var d_f64 = (:f64)-123s;
var e_f64 = (:f64)9223372036854775809u64;  # s64::MAX + 2
var f_f64 = (:f64)18446744073709551615u64; # u64::MAX
var g_f64 = (:f64)-9223372036854775808s64; # s64::MIN

func display[[T]](value: T) void {
    std::print_format_line(
        std::out(),
        "{}",
        (:[]std::formatter)[std::formatter::init[[T]](&value)]);
}

func main() void {
    std::print_line(std::out(), "COMPILE-TIME KNOWN");
    display[[f32]](a_f32);
    display[[f32]](b_f32);
    display[[f32]](c_f32);
    display[[f32]](d_f32);
    display[[f32]](e_f32);
    display[[f32]](f_f32);
    display[[f32]](g_f32);

    display[[f64]](a_f64);
    display[[f64]](b_f64);
    display[[f64]](c_f64);
    display[[f64]](d_f64);
    display[[f64]](e_f64);
    display[[f64]](f_f64);
    display[[f64]](g_f64);

    std::print_line(std::out(), "RUN-TIME KNOWN");
    var a_f32 = (:f32)+123;
    var b_f32 = (:f32)-123;
    var c_f32 = (:f32)+123s;
    var d_f32 = (:f32)-123s;
    var e_f32 = (:f32)9223372036854775809u64;
    var f_f32 = (:f32)18446744073709551615u64;
    var g_f32 = (:f32)-9223372036854775808s64;

    var a_f64 = (:f64)+123;
    var b_f64 = (:f64)-123;
    var c_f64 = (:f64)+123s;
    var d_f64 = (:f64)-123s;
    var e_f64 = (:f64)9223372036854775809u64;
    var f_f64 = (:f64)18446744073709551615u64;
    var g_f64 = (:f64)-9223372036854775808s64;

    display[[f32]](a_f32);
    display[[f32]](b_f32);
    display[[f32]](c_f32);
    display[[f32]](d_f32);
    display[[f32]](e_f32);
    display[[f32]](f_f32);
    display[[f32]](g_f32);

    display[[f64]](a_f64);
    display[[f64]](b_f64);
    display[[f64]](c_f64);
    display[[f64]](d_f64);
    display[[f64]](e_f64);
    display[[f64]](f_f64);
    display[[f64]](g_f64);
}
